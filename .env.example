# Banco do app (o docker compose sobe um Postgres nesta porta)
DATABASE_URL=postgres://ingresso:ingresso@localhost:55433/ultimo_ingresso
# Opcional: conexão direta (sem pooler) só para as migrações, quando DATABASE_URL passa por um pooler (ex.: Neon na Vercel)
# DATABASE_URL_MIGRACAO=
# Banco dos testes de integração (criado junto com o contêiner)
DATABASE_URL_TESTE=postgres://ingresso:ingresso@localhost:55433/ultimo_ingresso_teste
# Duração da reserva, em segundos
RESERVA_TTL_SEGUNDOS=30
